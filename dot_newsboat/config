# Browser
browser "firefox %u"

# ------------------------------------------------------------
# Movement
# ------------------------------------------------------------

bind j everywhere down
bind k everywhere up
bind gg everywhere home
bind gG everywhere end
bind ^D everywhere halfpagedown
bind ^U everywhere halfpageup

# Keep cursor away from top/bottom edges
scrolloff 4

# ------------------------------------------------------------
# Feed behavior
# ------------------------------------------------------------
# Only show feeds that actually have unread items
show-read-feeds no

# Retry flaky feeds
download-retries 2

# Parallelize feed downloads a bit
reload-threads 4

# ------------------------------------------------------------
# Reading
# ------------------------------------------------------------

# Don't stretch articles across a huge terminal
text-width 100

# ------------------------------------------------------------
# Colors
# ------------------------------------------------------------

highlight all "---.*---" color131 default bold
highlight all ".*(0/0))" black
highlight article "^Feed.*" color69 default bold
highlight article "^Title:.*" color166 default bold
highlight article "^Author.*" color111 default bold
highlight article "^Link:" color69
highlight article "https?://[^ ]+" green

# ------------------------------------------------------------
# Podboat
# ------------------------------------------------------------

player "mpv --no-video"
download-path "~/podboat-downloads" 
max-downloads 2
